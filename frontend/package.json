{
  "name": "stage-light-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "esbuild scripts/verifyMerge.ts scripts/verifyLock.ts --bundle --platform=node --format=esm --outdir=/tmp/stage-light-verify --define:import.meta.env.VITE_RECONCILE_DELAY_MS=350 --define:import.meta.env.VITE_DB_NAME='\"stage-light\"' && node /tmp/stage-light-verify/verifyMerge.js && node /tmp/stage-light-verify/verifyLock.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.2",
    "typescript": "^5.5.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0"
  }
}
